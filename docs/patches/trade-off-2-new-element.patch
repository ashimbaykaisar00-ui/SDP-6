diff --git a/src/test/java/com/stockexchange/visitor/CryptoAssetTest.java b/src/test/java/com/stockexchange/visitor/CryptoAssetTest.java
new file mode 100644
index 0000000..4c04dde
--- /dev/null
+++ b/src/test/java/com/stockexchange/visitor/CryptoAssetTest.java
@@ -0,0 +1,33 @@
+package com.stockexchange.visitor;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import com.stockexchange.visitor.composite.Account;
+import com.stockexchange.visitor.leaf.CryptoAsset;
+import com.stockexchange.visitor.visitors.AssetFilterVisitor;
+import com.stockexchange.visitor.visitors.RiskScoreVisitor;
+import com.stockexchange.visitor.visitors.TotalValueVisitor;
+import com.stockexchange.visitor.visitors.XmlExportVisitor;
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+
+class CryptoAssetTest {
+    private final TotalValueVisitor valuation = new TotalValueVisitor(
+            s -> s.equals("BTC") ? Optional.of(new BigDecimal("40000")) : Optional.empty());
+    private final Account wallet = new Account("W", List.of(new CryptoAsset("BTC", 2, new BigDecimal("30000"))));
+
+    @Test
+    void valueRiskAndFilterOfTheNewElement() {
+        assertEquals(0, new BigDecimal("80000").compareTo(wallet.accept(valuation)));      // 2 x 40000
+        assertEquals(98.0, wallet.accept(new RiskScoreVisitor(valuation)), 1e-9);
+        assertEquals(1, wallet.accept(AssetFilterVisitor.bySymbol("BTC")).size());
+    }
+
+    @Test
+    void xmlExportKnowsTheNewElement() {
+        assertEquals("<account id=\"W\"><crypto symbol=\"BTC\" units=\"2\" costBasis=\"30000\"/></account>",
+                wallet.accept(new XmlExportVisitor()));
+    }
+}
