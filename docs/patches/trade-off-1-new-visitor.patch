+package com.stockexchange.visitor.visitors;
+
+import com.stockexchange.visitor.StockElement;
+import com.stockexchange.visitor.StockVisitor;
+import com.stockexchange.visitor.composite.Account;
+import com.stockexchange.visitor.composite.Portfolio;
+import com.stockexchange.visitor.leaf.Bond;
+import com.stockexchange.visitor.leaf.Fund;
+import com.stockexchange.visitor.leaf.OptionContract;
+import com.stockexchange.visitor.leaf.Stock;
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/** Market value per asset class (stock, bond, fund, option) for any subtree. */
+public final class AssetAllocationVisitor implements StockVisitor<Map<String, BigDecimal>> {
+    private final TotalValueVisitor valuation;
+
+    public AssetAllocationVisitor(TotalValueVisitor valuation) {
+        this.valuation = valuation;
+    }
+
+    @Override
+    public Map<String, BigDecimal> visit(Portfolio portfolio) {
+        return merge(portfolio.accounts());
+    }
+
+    @Override
+    public Map<String, BigDecimal> visit(Account account) {
+        return merge(account.holdings());
+    }
+
+    @Override
+    public Map<String, BigDecimal> visit(Stock stock) {
+        return Map.of("stock", stock.accept(valuation));
+    }
+
+    @Override
+    public Map<String, BigDecimal> visit(Bond bond) {
+        return Map.of("bond", bond.accept(valuation));
+    }
+
+    @Override
+    public Map<String, BigDecimal> visit(Fund fund) {
+        return Map.of("fund", fund.accept(valuation));
+    }
+
+    @Override
+    public Map<String, BigDecimal> visit(OptionContract option) {
+        return Map.of("option", option.accept(valuation));
+    }
+
+    private Map<String, BigDecimal> merge(List<? extends StockElement> children) {
+        Map<String, BigDecimal> totals = new TreeMap<>();
+        for (StockElement child : children) {
+            child.accept(this).forEach((assetClass, value) -> totals.merge(assetClass, value, BigDecimal::add));
+        }
+        return totals;
+    }
+}
